% Required packages
\usepackage{polyglossia}
\usepackage{hyperref}
\usepackage{etoolbox}
\usepackage{environ}

% ============================================
% Counters
% ============================================
\newcounter{exercise}[section]

% ============================================
% Storage macros
% ============================================
\def\exercise@storage{}
\def\solution@storage{}

% ============================================
% Language-dependent strings
% ============================================
\def\exercise@exercise@name{Übung}
\def\exercise@solution@name{Lösung}
\def\exercise@solutions@name{Lösungen zu den Übungen}
\def\exercise@see@name{siehe S.}

% ============================================
% Helper: Generate exercise reference with full hierarchy
% (handles section, subsection, and subsubsection)
% ============================================
\def\exercise@make@ref{%
  \ifnum\value{subsubsection}=0 %
    \ifnum\value{subsection}=0 %
      \thesection\alph{exercise}%
    \else
      \thesubsection\alph{exercise}%
    \fi
  \else
    \thesubsubsection\alph{exercise}%
  \fi
}

% ============================================
% Exercise environment
% ============================================
\RequirePackage{mdframed}
\definecolor{exercise@bg}{RGB}{235, 245, 255}
\definecolor{exercise@border}{RGB}{100, 150, 220} % Medium blue

\newmdenv[%
  backgroundcolor=exercise@bg,
  linecolor=exercise@border,
%   linewidth=1pt,
  roundcorner=4pt,
  innertopmargin=6pt,
  innerbottommargin=6pt,
  innerleftmargin=8pt,
  innerrightmargin=8pt,
  skipabove=0.5em,
  skipbelow=0.5em
]{exercisebox}

\NewEnviron{exercise}{%
  \refstepcounter{exercise}%
  \edef\current@exercise@ref{\exercise@make@ref}%
  \begin{exercisebox}%
    \par\noindent%
    \textbf{\exercise@exercise@name\ \current@exercise@ref)}%
    \hspace{0.5em}%
    \BODY%
  \end{exercisebox}%
  % Store exercise in storage
%   \xappto{\exercise@storage}{%
%     \noexpand\item[\textbf{\current@exercise@ref}] %
%     \unexpanded{\expandafter\BODY}%
%   }%
}

% ============================================
% Solution environment (used inside exercise)
% ============================================
\newenvironment{solution}{%
  \textbf{(\exercise@solution@name\ \exercise@see@name\ \pageref{sec:solutions})}%
%   \collect@solution
}{%
