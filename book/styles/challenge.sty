% Exercises
%
% TODO
% - expand the code so that it is possible to have \printexercises, which prints
%   exercises with solutions (but it must handle formatting as if withing the exercisebox!)

\usepackage{verbatim}
\usepackage{fancyvrb}

% Files
\def\exercisedir{anhang/exercises}

\def\theexercisesfile{\exercisedir/\jobname.exercises.tex} % FIXME currently unused, see TODO
\newwrite\exercisesfile
\immediate\openout\exercisesfile=\theexercisesfile

\def\thesolusionsfile{\exercisedir/\jobname.solutions.tex}
\newwrite\solutionsfile
\immediate\openout\solutionsfile=\thesolusionsfile

% Counters and Ifs
\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\alph{exercise}}

\newcounter{solution}

\newif\ifexercises
\newif\ifsolutions
\newif\ifinsideexercise

\exercisesfalse
\solutionsfalse

% Output files
\newenvironment{exercise}{%
    \insideexercisetrue%
    \refstepcounter{exercise}%
    \edef\current@exercise@number{\thechapter\theexercise}%

    % Display the exercise
    \begin{exercisebox}%
        \par\noindent%
        \phantomsection%
        \textbf{\exercise@name~\current@exercise@number:}%
        \label{\jobname:exercise:\current@exercise@number}%
        \hspace{0.5em}%
}{%
        \vskip0pt\hfill\textbf{(\solution@name~\pageabbr~\pageref{\jobname:solution:\current@exercise@number})}
    \end{exercisebox}%
    \insideexercisefalse%
}

\newenvironment{challenge}{%
    \insideexercisetrue%
    \refstepcounter{exercise}%
    \edef\current@exercise@number{\thechapter\theexercise}%

    % Display the exercise
    \begin{challengebox}%
        \par\noindent%
        \phantomsection%
        \textbf{\exercise@name~\current@exercise@number:}%
        \label{\jobname:exercise:\current@exercise@number}%
        \hspace{0.5em}%
}{%
        \vskip0pt\hfill\textbf{(\solution@name~\pageabbr~\pageref{\jobname:solution:\current@exercise@number})}
    \end{challengebox}%
    \insideexercisefalse%
}

\newenvironment{solution}{%
    \ifinsideexercise{}\else\PackageError{challenge}{Solution outside exercise}{...}\fi%

    \refstepcounter{solution}%
    \edef\current@solutionfile{\exercisedir/\jobname.solution-\arabic{solution}.tex}

    \immediate\write\solutionsfile{%
        \string\vskip1.5em%
        \string\par\string\noindent%
        \string\phantomsection
        \string\textbf{\solution@name\ \current@exercise@number}%
        \string\label{\jobname:solution:\current@exercise@number}%
        \string\par\string\noindent%
        \string\input{\current@solutionfile}
    }%

    \VerbatimEnvironment
    \VerbatimOut{\current@solutionfile}%
}{%
    \endVerbatimOut
}

\def\printsolutions{%
    \solutionstrue%
    \immediate\closeout\solutionsfile%
    \input{\thesolusionsfile}%
}

